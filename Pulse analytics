                    </button>
                    <button onclick="switchCity('liege')" id="city-btn-liege" class="px-4 py-2 rounded-lg text-xs font-bold transition-all text-slate-400 hover:text-white">
                        <i class="fa-solid fa-building-columns mr-1"></i> Luik / Liège (4000)
