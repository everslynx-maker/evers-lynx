                            <canvas id="financialChart"></canvas>
                        </div>
                    </div>

                    <!-- City Event Intelligence Card (1 col) -->
                    <div class="bg-gradient-to-br from-blue-950/60 to-slate-950 p-5 rounded-xl border border-blue-900/50 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-blue-600 text-white flex items-center gap-1.5 shadow">
                                    <i class="fa-solid fa-location-dot"></i> <span id="event-city-badge">Leuven (3000)</span>
                                </span>
                                <span class="text-[10px] text-slate-400 uppercase tracking-wider font-semibold" data-i18n="event_impact_label">Impact Alert</span>
                            </div>

