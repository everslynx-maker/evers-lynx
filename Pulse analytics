                <a href="#support" class="hidden sm:inline-flex items-center gap-2 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-medium text-sm px-4 py-2.5 rounded-lg shadow-lg shadow-blue-600/25 transition-all">
