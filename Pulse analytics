                                <span id="event-advice">Verhoog bier & snack inkoop met 25%. Plan 2 extra kelners in voor de avondshift.</span>
                            </div>
                        </div>

                        <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
                            <span data-i18n="event_source">Bron: Visit Leuven API</span>
                            <a href="#calendar" class="text-blue-400 hover:underline font-medium" data-i18n="btn_full_calendar">Volledige Kalender →</a>
                        </div>
                    </div>
                </div>

                <!-- Report Action Buttons -->
                <div class="mt-8 pt-6 border-t border-slate-800 flex flex-wrap items-center justify-between gap-4">
                    <div class="text-xs text-slate-400 flex items-center gap-2">
                        <i class="fa-solid fa-file-shield text-emerald-400 text-sm"></i>
                        <span data-i18n="report_accountant_ready">Geformatteerd en klaar voor jouw boekhouder (PDF / CSV)</span>
                    </div>

                    <div class="flex items-center gap-3">
                        <button onclick="openEmailModal()" class="px-4 py-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold transition-all border border-slate-700 flex items-center gap-2">
                            <i class="fa-solid fa-paper-plane text-blue-400"></i>
                            <span data-i18n="btn_send_email">Verstuur Naar Mijn E-mail</span>
                        </button>
                        <button onclick="triggerPdfDownload()" class="px-4 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold transition-all shadow-lg shadow-blue-600/20 flex items-center gap-2">
                            <i class="fa-solid fa-download"></i>
                            <span data-i18n="btn_download_pdf">Download Rapport (PDF)</span>
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Interactive City Event Calendar Section -->
    <section id="calendar" class="py-16 bg-slate-950/60 border-y border-slate-800/80 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
                <div>
                    <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-emerald-400 mb-2">
                        <i class="fa-solid fa-city"></i> <span data-i18n="calendar_tag">Demand Forecasting System</span>
                    </div>
                    <h2 class="text-3xl font-bold text-white tracking-tight" data-i18n="calendar_heading">Stads-Intelligence Kalender</h2>
                    <p class="text-slate-400 text-sm mt-1 max-w-xl" data-i18n="calendar_subheading">
                        Wij synchroniseren de stadsagenda's van Leuven (3000) en Luik (4000) automatisch via open data. Zo sta je nooit meer onvoorbereid voor een vol of leeg terras.
                    </p>
                </div>

                <!-- City Selector Toggle -->
                <div class="flex items-center bg-slate-900 border border-slate-800 p-1.5 rounded-xl self-start md:self-auto">
                    <button onclick="switchCity('leuven')" id="city-btn-leuven" class="px-4 py-2 rounded-lg text-xs font-bold transition-all bg-blue-600 text-white shadow">
