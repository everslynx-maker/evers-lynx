                </a>
                <a href="#pricing" class="px-7 py-3.5 rounded-xl glass-card hover:bg-slate-800/80 text-slate-200 hover:text-white font-semibold transition-all border border-slate-700/80 flex items-center gap-2">
                    <i class="fa-solid fa-tags"></i>
                    <span data-i18n="btn_pricing">Bekijk Betaalbare Tarieven</span>
                </a>
            </div>

            <!-- Trust Pills -->
            <div class="mt-12 flex flex-wrap justify-center items-center gap-6 text-xs text-slate-400 font-medium">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-circle-check text-emerald-400"></i>
                    <span data-i18n="trust_1">Geen installatie nodig</span>
                </div>
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-circle-check text-emerald-400"></i>
                    <span data-i18n="trust_2">Kant-en-klaar voor je boekhouder</span>
                </div>
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-circle-check text-emerald-400"></i>
                    <span data-i18n="trust_3">Persoonlijke service op de zaak</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Interactive Report Preview Section -->
    <section id="demo" class="py-16 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-10">
                <h2 class="text-3xl font-bold text-white tracking-tight" data-i18n="demo_heading">De Pulse "Maandrekening" (Demo Dashboard)</h2>
                <p class="text-slate-400 mt-2 text-sm max-w-2xl mx-auto" data-i18n="demo_subheading">
                    Zo ziet jouw maandelijks verslag eruit. Geen saaie Excel-tabellen, maar een helder, interactief dashboard dat je ook direct per mail kan versturen.
                </p>
            </div>

            <!-- Interactive Demo Container -->
            <div class="glass-card gradient-border p-6 sm:p-8 rounded-2xl shadow-2xl bg-slate-900/90">
                
                <!-- Dashboard Top Bar: Month Selector & Export Buttons -->
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-800">
                    <div>
                        <div class="flex items-center gap-3">
                            <h3 class="text-xl font-bold text-white" id="client-name-heading">Brasserie De Ladeuze (Leuven)</h3>
                            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-950 text-emerald-400 border border-emerald-800/80" data-i18n="status_active">Actief Klant-ID #4820</span>
                        </div>
                        <p class="text-xs text-slate-400 mt-1" data-i18n="demo_period_label">Selecteer een rapportageperiode om het verslag te herberekenen:</p>
                    </div>

                    <!-- Month Switcher Pills -->
                    <div class="flex items-center gap-2 bg-slate-950 p-1.5 rounded-xl border border-slate-800">
                        <button onclick="changeMonth('april')" id="btn-april" class="month-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-blue-600 text-white shadow">
                            <i class="fa-solid fa-calendar-day mr-1"></i> April 2026
                        </button>
                        <button onclick="changeMonth('mei')" id="btn-mei" class="month-btn px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white transition-all">
                            <i class="fa-solid fa-calendar-day mr-1"></i> Mei 2026
                        </button>
                        <button onclick="changeMonth('juni')" id="btn-juni" class="month-btn px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white transition-all">
                            <i class="fa-solid fa-calendar-day mr-1"></i> Juni 2026
                        </button>
                    </div>
                </div>

                <!-- KPI Cards Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 my-8">
                    <!-- Omzet -->
                    <div class="p-4 rounded-xl bg-slate-950/80 border border-slate-800/80">
                        <div class="flex items-center justify-between text-slate-400 text-xs font-medium">
                            <span data-i18n="kpi_revenue">Totale Omzet</span>
                            <div class="w-7 h-7 rounded-lg bg-blue-500/10 flex items-center justify-center text-blue-400">
                                <i class="fa-solid fa-arrow-trend-up"></i>
                            </div>
                        </div>
