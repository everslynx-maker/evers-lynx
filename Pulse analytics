                <span data-i18n="hero_badge">Speciaal voor KMO's & Horeca in Leuven & Luik</span>
            </div>

            <!-- Main Headline -->
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-[1.15]">
                <span data-i18n="hero_title_1">Financieel Overzicht &</span> 
                <span class="gradient-text block mt-1" data-i18n="hero_title_2">Stads-Intelligence voor KMO's</span>
