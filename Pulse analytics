                </div>
            </div>

            <!-- Event Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="event-cards-container">
                <!-- Dynamically populated via JavaScript -->
            </div>
        </div>
    </section>

    <!-- USP / Boekhouder Besparing Section -->
    <section id="usp" class="py-20 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-3xl font-extrabold text-white tracking-tight" data-i18n="usp_title">
                    Waarom KMO's kiezen voor Pulse Analytics
                </h2>
                <p class="text-slate-400 text-base mt-3" data-i18n="usp_subtitle">
                    Drie simpele pijlers die jouw zaak direct geld en tijd besparen.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Card 1 -->
