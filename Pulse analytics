            elements.forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations[lang] && translations[lang][key]) {
                    el.innerText = translations[lang][key];
                }
            });

            showToast(`Taal gewijzigd naar ${lang.toUpperCase()}`);
        }

        function initChart() {
            const ctx = document.getElementById('financialChart').getContext('2d');
            chartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
                    datasets: [
                        {
                            label: 'Omzet (€)',
                            data: monthData.april.revenueArr,
                            backgroundColor: '#2563EB',
                            borderRadius: 6
                        },
                        {
                            label: 'Kosten (€)',
                            data: monthData.april.costArr,
                            backgroundColor: '#374151',
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: { color: '#9CA3AF', font: { size: 11 } }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: '#9CA3AF' },
                            grid: { color: 'rgba(255, 255, 255, 0.05)' }
                        },
                        y: {
                            ticks: { color: '#9CA3AF' },
                            grid: { color: 'rgba(255, 255, 255, 0.05)' }
                        }
                    }
                }
            });
        }

        function changeMonth(monthKey) {
            currentMonth = monthKey;
            const data = monthData[monthKey];

            // Update month buttons styling
            ['april', 'mei', 'juni'].forEach(m => {
                const btn = document.getElementById(`btn-${m}`);
                if (m === monthKey) {
                    btn.className = "month-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-blue-600 text-white shadow";
                } else {
                    btn.className = "month-btn px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white transition-all";
                }
            });

            // Update KPI text values
            document.getElementById('kpi-omzet').innerText = data.omzet;
            document.getElementById('kpi-omzet-trend').innerText = data.omzetTrend;
            document.getElementById('kpi-winst').innerText = data.winst;
            document.getElementById('kpi-marge').innerText = data.marge;
            document.getElementById('kpi-debiteuren').innerText = data.debiteuren;
            document.getElementById('kpi-crediteuren').innerText = data.crediteuren;

            // Update Event Intelligence Box
            document.getElementById('chart-month-label').innerText = data.chartLabel;
            document.getElementById('event-title').innerText = data.eventTitle;
            document.getElementById('event-desc').innerText = data.eventDesc;
            document.getElementById('event-advice').innerText = data.eventAdvice;

            // Update Chart.js datasets
            if (chartInstance) {
                chartInstance.data.datasets[0].data = data.revenueArr;
                chartInstance.data.datasets[1].data = data.costArr;
                chartInstance.update();
            }

            showToast(`Maandrakening bijgewerkt voor ${monthKey.toUpperCase()} 2026`);
        }

        function switchCity(city) {
            currentCity = city;
            const btnLeuven = document.getElementById('city-btn-leuven');
            const btnLiege = document.getElementById('city-btn-liege');

            if (city === 'leuven') {
                btnLeuven.className = "px-4 py-2 rounded-lg text-xs font-bold transition-all bg-blue-600 text-white shadow";
                btnLiege.className = "px-4 py-2 rounded-lg text-xs font-bold transition-all text-slate-400 hover:text-white";
                document.getElementById('event-city-badge').innerText = "Leuven (3000)";
            } else {
                btnLiege.className = "px-4 py-2 rounded-lg text-xs font-bold transition-all bg-blue-600 text-white shadow";
                btnLeuven.className = "px-4 py-2 rounded-lg text-xs font-bold transition-all text-slate-400 hover:text-white";
                document.getElementById('event-city-badge').innerText = "Luik (4000)";
            }

            renderCityEvents(city);
            showToast(`Stadskalender geschakeld naar ${city.toUpperCase()}`);
        }

        function renderCityEvents(city) {
            const container = document.getElementById('event-cards-container');
            const events = cityEventsData[city];

            container.innerHTML = events.map(evt => `
                <div class="glass-card p-5 rounded-xl border border-slate-800 flex flex-col justify-between hover:border-blue-500/40 transition-all">
                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <span class="text-xs font-semibold text-slate-400"><i class="fa-regular fa-calendar mr-1"></i> ${evt.date}</span>
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold ${evt.impact === 'HIGH' ? 'bg-red-950 text-red-400 border border-red-800' : 'bg-amber-950 text-amber-400 border border-amber-800'}">
                                ${evt.impact} IMPACT
                            </span>
                        </div>
                        <h4 class="text-sm font-bold text-white mb-2">${evt.title}</h4>
                        <p class="text-xs text-slate-300 leading-relaxed mb-4">${evt.desc}</p>
                    </div>
                    <div class="p-3 rounded-lg bg-slate-950 border border-slate-800 text-xs text-blue-300 font-medium">
                        ${evt.tip}
                    </div>
                </div>
            `).join('');
        }

        function setRating(stars) {
            selectedRating = stars;
            const starContainer = document.getElementById('star-rating');
            const starsList = starContainer.children;

            for (let i = 0; i < 5; i++) {
                if (i < stars) {
                    starsList[i].className = "fa-solid fa-star text-amber-400 cursor-pointer";
                } else {
                    starsList[i].className = "fa-solid fa-star text-slate-700 cursor-pointer";
                }
            }

            document.getElementById('rating-text').innerText = `Score: ${stars}/5 Sterren`;
        }

        function submitFeedback() {
            if (selectedRating === 0) {
                showToast("Selecteer eerst een aantal sterren!");
                return;
            }
            showToast("Bedankt! Je feedback is verzonden naar Pulse Analytics.");
            document.getElementById('feedback-text').value = '';
        }

        function handleSupportSubmit(e) {
            e.preventDefault();
            showToast("Aanvraag ontvangen! We nemen binnen 24 uur contact op.");
            e.target.reset();
        }

        function selectPlan(planName) {
            showToast(`Pakket '${planName}' geselecteerd! We openen de inschrijving...`);
            document.getElementById('support').scrollIntoView({ behavior: 'smooth' });
        }

        function openEmailModal() {
            document.getElementById('email-modal').classList.remove('hidden');
        }

        function closeEmailModal() {
            document.getElementById('email-modal').classList.add('hidden');
        }

        function sendEmailSimulated() {
            closeEmailModal();
            showToast("Maandrekening verzonden per e-mail!");
        }

        function triggerPdfDownload() {
            showToast("Genereren van PDF Maandrekening gestart...");
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-message');
            toastMsg.innerText = message;

            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
</body>
</html>
