                            <span data-i18n="kpi_profit">Netto Winst</span>
                            <div class="w-7 h-7 rounded-lg bg-emerald-500/10 flex items-center justify-center text-emerald-400">
                                <i class="fa-solid fa-wallet"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-2xl font-extrabold text-emerald-400" id="kpi-winst">€ 3.650,00</div>
