                    <button onclick="setLanguage('fr')" id="lang-fr" class="px-2 py-1 rounded-md font-semibold transition-all text-slate-400 hover:text-white">FR</button>
                    <button onclick="setLanguage('de')" id="lang-de" class="px-2 py-1 rounded-md font-semibold transition-all text-slate-400 hover:text-white">DE</button>
